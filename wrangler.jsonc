{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "otp-backend",
	"main": "worker.js",
	"compatibility_date": "2026-09-16",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "TRANSACTIONS_KV",
			"id": "f65a94d9ccdb426cb203ddd6a32140dd"
		}
	]
}