{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "otp-backend",
  "main": "worker.js",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
